# Copy to server/.env (never commit .env).

# ── Chat (required for /v1/chat) ──────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key_here

# Gemini model to use (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── Vision (required for /v1/vision/disease) ──────────────────────────────────
# AGRI_YOLO_WEIGHTS=/path/to/best.pt

# ── Server ────────────────────────────────────────────────────────────────────
# AGRI_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# AGRI_MAX_IMAGE_MB=12
